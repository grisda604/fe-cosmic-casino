# =============================================================================
# Vercel: Project → Settings → Environment Variables
# เพิ่มตัวแปรด้านล่าง (Environment: Production · แนะนำ Preview ด้วยถ้าทดบน preview URL)
# Sensitive = เปิดสำหรับ AUTH_DEMO_LOGIN_PASSWORD และ AUTH_SESSION_SECRET
# หลังบันทึก → Deployments → Redeploy (env ไม่มีผลกับ deploy เก่า)
# =============================================================================

AUTH_ENABLE_DEMO_USER=1
AUTH_DEMO_LOGIN_PHONE=0999999999
AUTH_DEMO_LOGIN_PASSWORD=1111

# สุ่มใหม่บน production (อย่างน้อย 32 ตัวอักษร) — ห้าม commit ค่าจริง
# ตัวอย่างสร้าง: openssl rand -base64 32
AUTH_SESSION_SECRET=replace-with-random-secret-min-32-chars

# --- Optional ---
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
# NEXT_PUBLIC_API_BASE_URL=
